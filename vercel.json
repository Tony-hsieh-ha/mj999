{
  "version": 2,
  "name": "mj999-admin-system",
  "builds": [
    {
      "src": "api.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api.js"
    },
    {
      "src": "/admin",
      "dest": "/admin.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1.html"
    }
  ],
  "env": {
    "ADMIN_PASSWORD": "@admin_password",
    "LINE_NOTIFY_TOKEN": "@line_notify_token",
    "LINE_CLIENT_SECRET": "@line_client_secret",
    "DEFAULT_LOCATION": "@default_location"
  },
  "functions": {
    "api.js": {
      "maxDuration": 10
    }
  }
}
