{
  "version": 2,
  "name": "smart-matching-system",
  "builds": [
    {
      "src": "**/*.{html,js,css,md}",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/line-login",
      "dest": "/line-login.html"
    },
    {
      "src": "/invite-system",
      "dest": "/invite-system.html"
    }
  ]
}
